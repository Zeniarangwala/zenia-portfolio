---
// Live type specimen for the Greyhound wordmark and body faces.
import '@fontsource-variable/archivo/wdth.css';
---
<div class="specimen">
  <p class="specimen-label">Final wordmark</p>
  <p class="specimen-word" aria-hidden="true">Greyhound</p>
  <dl>
    <div>
      <dt>Headings</dt>
      <dd><span class="specimen-archivo">Archivo Expanded SemiBold</span>: wide and steady, and still friendly next to the dog.</dd>
    </div>
    <div>
      <dt>Body</dt>
      <dd>Inter, so everything is easy to read on tickets and phones.</dd>
    </div>
  </dl>
</div>
