---
import { links } from '../data/site';

const path = Astro.url.pathname;
const nav = [
  { href: '/#work', label: 'Work', current: path.startsWith('/work') },
  { href: '/about/', label: 'About', current: path.startsWith('/about') },
  { href: links.linkedin, label: 'LinkedIn', external: true },
];
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="Zenia Rangwala, home">
      <span class="brand-name">Zenia Rangwala</span>
      <span class="brand-role">Graphic + UX Designer</span>
    </a>
    <nav class="nav-pill" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={item.current ? 'page' : undefined}>
              {item.label}{item.external && <span aria-hidden="true"> ↗</span>}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="header-actions">
      <p class="status">
        <span class="status-dot" aria-hidden="true"></span>
        <span class="status-text">Open to internships</span>
      </p>
      <a class="btn" href={links.resume}>Resume <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</header>
