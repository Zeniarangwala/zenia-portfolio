---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption?: string;
  eager?: boolean;
}
const { src, alt, width, height, caption, eager = false } = Astro.props;
---
<figure class="figure">
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
