---
// variant: 'card' (default) frames screenshots and photos on a white card.
// 'cutout' is for transparent mockups and objects: no frame, no background.
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption?: string;
  eager?: boolean;
  variant?: 'card' | 'cutout';
}
const { src, alt, width, height, caption, eager = false, variant = 'card' } = Astro.props;
const portrait = height > width * 1.1;
---
<figure class:list={['figure', `figure--${variant}`, { 'figure--portrait': portrait }]}>
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
