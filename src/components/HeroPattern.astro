---
// A quiet field of dots and small sparkles behind the hero. A slow wave moves
// through it, and marks near the mouse gently turn cobalt: the overlooked,
// noticed. It is drawn by src/scripts/motion.ts and is purely decorative.
//
// Because it moves on its own for more than five seconds, WCAG 2.2.2 needs a
// way to pause it, so the button below sits right next to it. It flips the
// same "Reduce motion" setting as the "View your way" panel, so the two always
// agree and the choice is saved.
---
<canvas class="hero-pattern" aria-hidden="true" data-pattern></canvas>
<button class="motion-toggle" type="button" data-motion-toggle hidden>
  <svg class="motion-toggle-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path class="icon-pause" d="M8 5v14M16 5v14" />
    <path class="icon-play" d="M7 4.5v15l12-7.5z" />
  </svg>
  <span data-motion-label>Pause motion</span>
</button>
