---
// Floating project tiles beside the hero headline. Purely decorative: the same
// projects are linked properly in "Selected work" below, so these links are
// hidden from screen readers and skipped by the keyboard. They are a shortcut
// for mouse users only, and they disappear on narrow screens.
import { getCollection } from 'astro:content';
import { cards } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// Where each tile sits in the collage (percent of the box), its tilt, and how
// strongly it follows the pointer. Bigger depth = feels closer = moves more.
const layout = [
  { x: 20, y: 0, w: 54, r: -5, depth: 1 },
  { x: 66, y: 14, w: 36, r: 6, depth: 0.45 },
  { x: 0, y: 40, w: 42, r: 3, depth: 0.7 },
  { x: 50, y: 52, w: 48, r: -3, depth: 1.2 },
  { x: 22, y: 78, w: 34, r: -7, depth: 0.55 },
];

const tiles = projects
  .map((p, i) => ({ p, card: cards[p.data.slug], pos: layout[i % layout.length], i }))
  .filter((t) => t.card?.thumb);
---
<div class="collage" aria-hidden="true" data-collage>
  {tiles.map(({ p, card, pos, i }) => (
    <a
      class="tile"
      href={`/work/${p.data.slug}/`}
      tabindex="-1"
      data-depth={pos.depth}
      style={`--x:${pos.x}%;--y:${pos.y}%;--w:${pos.w}%;--r:${pos.r}deg;--i:${i};`}
    >
      <span class="tile-inner">
        <img src={card!.thumb} alt="" width="1200" height="750" loading="eager" decoding="async" />
        <span class="tile-label">{p.data.name}</span>
      </span>
    </a>
  ))}
</div>
