---
import '@fontsource-variable/hanken-grotesk';
import '@fontsource/opendyslexic/400.css';
import '@fontsource/opendyslexic/700.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PrefsPanel from '../components/PrefsPanel.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f2e8" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <!-- TODO: Zenia to confirm — og:image (1200 × 630) once the domain and preview image exist -->
    <script is:inline>
      // Apply saved reading preferences before the page paints.
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var prefs = JSON.parse(localStorage.getItem('zr-prefs') || '{}');
          for (var key in prefs) if (prefs[key]) root.dataset[key] = prefs[key];
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <PrefsPanel />
    <script>
      // Fade cards and sections up as they scroll in. Skipped with reduced motion.
      const root = document.documentElement;
      const reduce = () =>
        matchMedia('(prefers-reduced-motion: reduce)').matches || root.dataset.motion === 'reduce';
      const items = document.querySelectorAll('.reveal');
      if (reduce() || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        items.forEach((el) => io.observe(el));
      }

      const header = document.querySelector('.site-header');
      const onScroll = () => header?.classList.toggle('is-stuck', window.scrollY > 8);
      onScroll();
      addEventListener('scroll', onScroll, { passive: true });
    </script>
  </body>
</html>
