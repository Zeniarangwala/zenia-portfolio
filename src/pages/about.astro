---
import BaseLayout from '../layouts/BaseLayout.astro';
import { links } from '../data/site';
import HeroPattern from '../components/HeroPattern.astro';

const experience = [
  { role: 'Business Development and Marketing Intern', org: 'CrunchTimeZ CFO Services', when: '2026' },
  { role: 'Community and Brand Design Intern', org: 'She Hacks Purple Consulting', when: '2026' },
  { role: 'Digital Marketing Coordinator', org: 'GoLime', when: '2024' },
  { role: 'Product Designer', org: 'Goodself', when: '2024' },
];

const education = [
  { role: 'MFA, Graphic Design and Visual Experience', org: 'SCAD', when: '2026–Present' },
  { role: 'BA, Global Business and Digital Arts', org: 'University of Waterloo', when: '2026' },
];

const contact = [
  { label: 'Email', text: links.email, href: `mailto:${links.email}` },
  { label: 'LinkedIn', text: 'linkedin.com/in/zeniarangwala', href: links.linkedin },
  { label: 'Resume', text: 'Download PDF', href: links.resume },
];

// Mile Markers route line, ending at the finish flag.
const route = 'M8 120 C 120 120, 150 50, 260 60 S 400 140, 520 104 S 660 30, 780 52 S 900 110, 968 62';
---
<BaseLayout
  title="About — Zenia Rangwala"
  description="About Zenia Rangwala: a UX designer doing an MFA in Graphic Design and Visual Experience at SCAD, with a background in business, marketing and UX."
>
  <div class="wrap">
    <header class="about-hero">
      <HeroPattern />
      <div class="about-hero-text">
        <h1>Hey! I'm Zenia.</h1>
        <p class="prose">
          I'm currently doing my Master of Fine Arts at SCAD in Graphic Design and Visual
          Experience. I'm passionate about creating inclusive and accessible designs for people in
          underrepresented communities. With a background in business, marketing and UX, I love design
          that looks good and actually works for the people using it.
        </p>
      </div>
      {/* The outline arch and sparkle behind the photo are decorative; with motion
          on they drift gently with the mouse (see motion.ts). */}
      <div class="arch-frame" data-arch>
        <span class="arch-echo" aria-hidden="true"></span>
        <svg class="arch-spark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M12 0C12.9 6.6 17.4 11.1 24 12 17.4 12.9 12.9 17.4 12 24 11.1 17.4 6.6 12.9 0 12 6.6 11.1 11.1 6.6 12 0Z" fill="currentColor" />
        </svg>
        <figure class="arch">
          <img src="/images/about/zenia.webp" alt="Zenia smiling in a cream top, standing in a bright hallway." width="320" height="400" loading="eager" />
        </figure>
      </div>
    </header>

    <div class="about-grid">
      <section class="about-section reveal" aria-labelledby="exp-heading">
        <h2 id="exp-heading" class="label">Experience</h2>
        <ol class="timeline" data-timeline>
          {experience.map((e) => (
            <li>
              <p class="role">{e.role}</p>
              <p class="muted">{e.org} · {e.when}</p>
            </li>
          ))}
        </ol>
      </section>

      <div>
        <section class="about-section reveal" aria-labelledby="edu-heading">
          <h2 id="edu-heading" class="label">Education</h2>
          <ul class="rows">
            {education.map((e) => (
              <li>
                <span class="role">{e.role}</span>
                <span class="org">{e.org} · {e.when}</span>
              </li>
            ))}
          </ul>
        </section>

        <section class="about-section" aria-labelledby="contact-heading">
          <h2 id="contact-heading" class="label">Contact</h2>
          <ul class="contact-grid">
            {contact.map((c) => (
              <li>
                <a class="contact-btn" href={c.href}>
                  <span class="contact-label">{c.label} <span class="arrow" aria-hidden="true">↗</span></span>
                  <span class="contact-text">{c.text}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </div>

    <section class="miles" aria-labelledby="miles-heading" data-miles>
      <div class="miles-head">
        <h2 id="miles-heading" class="label">Mile Markers</h2>
        {/* Counts up to a half marathon as you scroll (decorative; see motion.ts). */}
        <p class="miles-odometer" aria-hidden="true"><span data-odometer>21.1</span> km</p>
      </div>
      <p class="prose">
        I'm training for my first half marathon in March 2027, which so far means a lot of
        "okay, just one more mile" deals with myself. When I'm not running, I'm dancing, or on a
        very serious mission to find the best latte in the city. Ask me for a café rec. I have
        opinions.
      </p>
      <svg class="miles-route" viewBox="0 0 1000 150" aria-hidden="true" focusable="false">
        <defs>
          <mask id="miles-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="1000" height="150">
            <path class="route-draw" d={route} fill="none" stroke="#fff" stroke-width="14" pathLength="1" stroke-dasharray="1" stroke-dashoffset="0" />
          </mask>
        </defs>
        <circle cx="8" cy="120" r="6" fill="var(--accent)" />
        <path d={route} mask="url(#miles-mask)" data-route fill="none" stroke="var(--accent)" stroke-width="3" stroke-linecap="round" stroke-dasharray="0 10" vector-effect="non-scaling-stroke" />
        <g class="miles-flag" transform="translate(968 62)">
          <path d="M0 0V-40" stroke="var(--text)" stroke-width="2.5" stroke-linecap="round" />
          <path class="flag-cloth" d="M0 -40h22l-6 7 6 7H0z" fill="var(--accent)" />
        </g>
        {/* A runner that travels the route as it draws in (motion only). */}
        <circle class="miles-runner" r="7" fill="var(--accent)" stroke="var(--tint)" stroke-width="3" cx="8" cy="120" data-runner />
      </svg>
    </section>
  </div>
</BaseLayout>
