---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { cards } from '../../data/site';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.data.slug },
    props: { project, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

const { project, prev, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);

// Open questions stay as "TODO: Zenia to confirm" in the MDX, but never reach the page.
const clean = (text: string) => text.replace(/\.?\s*TODO\b.*$/s, '').trim();
const facts = [
  ['Role', data.role],
  ['Team', data.team],
  ['Tools', data.tools],
  ['Timeline', data.timeline],
]
  .map(([label, value]) => [label, clean(value)])
  .filter(([, value]) => value);
const hero = cards[data.slug]?.thumb;
---
<BaseLayout title={`${data.name} — Zenia Rangwala`} description={`${data.title}. ${data.problem}`}>
  <article class="wrap">
    <header class="case-header">
      <p class="label">{data.name} · {data.discipline}</p>
      <h1>{data.title}</h1>
      <p class="problem">{data.problem}</p>
    </header>

    {hero && (
      <img class="case-hero" src={hero} alt={data.coverAlt} width="1200" height="750" loading="eager" />
    )}

    <dl class="facts">
      {facts.map(([label, value]) => (
        <div>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>

    <section class="tldr" aria-labelledby="tldr-heading">
      <h2 id="tldr-heading">TL;DR</h2>
      <ul>
        {data.tldr.map((point) => <li>{point}</li>)}
      </ul>
    </section>

    <div class="case-body">
      <Content />
    </div>

    <nav class="case-nav" aria-label="More projects">
      {prev ? <a class="btn btn-ghost" href={`/work/${prev.data.slug}/`}><span aria-hidden="true">←</span> Previous: {prev.data.name}</a> : <span />}
      {next ? <a class="btn" href={`/work/${next.data.slug}/`}>Next: {next.data.name} <span aria-hidden="true">→</span></a> : <a class="btn" href="/#work">Back to all work</a>}
    </nav>
  </article>
</BaseLayout>
